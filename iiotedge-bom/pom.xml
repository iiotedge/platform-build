<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.iiotedge.build</groupId>
    <artifactId>iiotedge-bom</artifactId>
    <version>2026.11.18</version>
    <packaging>pom</packaging>
    <name>IoTMining BOM</name>
    <description>Central dependency version alignment for all IoTMining services</description>
    <url>https://github.com/iiotedge/platform-build</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/iiotedge/platform-build</url>
        <connection>scm:git:https://github.com/iiotedge/platform-build.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/iiotedge/platform-build.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <!-- Publish target: GitHub Packages (owner/repo must match your repo) -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/iiotedge/platform-build</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages (Snapshots)</name>
            <url>https://maven.pkg.github.com/iiotedge/platform-build</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <!-- Core stack. Spring Boot 4.0.x is the newest Boot line with a GA Spring Cloud
             train (2025.1.x); Boot 4.1's train (2026.0) is not GA yet. -->
        <java.version>21</java.version>
        <spring.boot.version>4.0.9</spring.boot.version>
        <spring.cloud.version>2025.1.4</spring.cloud.version>

        <!-- Only libraries that spring-boot-dependencies does NOT manage are pinned
             below. Everything Boot manages (Jackson 2 and 3, Micrometer/tracing,
             Testcontainers, Flyway, Postgres, MySQL, Mongo, Lettuce, Kafka, RabbitMQ,
             Elasticsearch, Caffeine, commons-lang3, JUnit, AssertJ, Mockito,
             Awaitility) comes from the Boot BOM imported first in dependencyManagement,
             so there is one source of truth per artifact.

             The 2025.08.x BOM pinned several of those explicitly. Explicit entries beat
             imported ones, and Boot manages JUnit/Mockito/AssertJ only through its own
             BOM imports, so those pins silently overrode Boot's test stack for every
             iiotedge-parent child (junit-jupiter 5.10.3 / mockito-core 5.12.0 under
             Boot 3.4.4). Under Boot 4 the same pins would mix JUnit 5 with JUnit 6,
             Kafka 3 with Kafka 4 and Testcontainers 1.x modules with the 2.x core. -->

        <!-- Data & infra -->
        <minio.version>8.5.9</minio.version>

        <!-- Serialization / schema -->
        <protobuf.version>3.25.3</protobuf.version>
        <confluent.avro.version>7.7.1</confluent.avro.version>

        <!-- Security -->
        <jjwt.version>0.12.6</jjwt.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <passay.version>1.7.4</passay.version>
        <!-- ShedLock 7.x is the Spring Framework 7 / Boot 4 line (5.x targets Spring 6.1).
             7.9.0 is the newest release built against Boot 4.0.x (4.0.7, Spring 7.0.8);
             7.10+ is built against Boot 4.1. -->
        <shedlock.version>7.9.0</shedlock.version>

        <!-- Utils / logging -->
        <mapstruct.version>1.6.2</mapstruct.version>
        <problem.spring.version>0.29.1</problem.spring.version>
        <logstash.encoder.version>7.4</logstash.encoder.version>
        <logbook.version>3.8.0</logbook.version>

        <!-- Testing (not managed by Boot) -->
        <wiremock.version>3.9.2</wiremock.version>
        <restassured.version>5.5.0</restassured.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring BOMs. Boot first: for any artifact both BOMs manage, the first
                 import wins. Boot's BOM also imports the Jackson (tools.jackson 3.x and
                 com.fasterxml.jackson 2.x), Micrometer, Micrometer Tracing and
                 Testcontainers BOMs, so this BOM no longer imports them separately. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring.cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Core libs (versions pinned here; services omit versions) -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- Serialization / schema -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-avro-serializer</artifactId>
                <version>${confluent.avro.version}</version>
            </dependency>
            <dependency>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-schema-registry-client</artifactId>
                <version>${confluent.avro.version}</version>
            </dependency>

            <!-- Security -->
            <!-- All three must move together - api/impl/jackson at mismatched
                 versions is exactly the kind of thing dependencyConvergence
                 exists to catch (and did, the first time a real service -
                 auth-service - adopted this BOM: impl/jackson weren't pinned
                 here at all, so their own transitive jjwt-api requirement
                 got silently overridden to whatever version *was* pinned).
                 jjwt-jackson uses Jackson 2 (com.fasterxml), which Boot 4 still
                 manages through its jackson-2-bom import. -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.passay</groupId>
                <artifactId>passay</artifactId>
                <version>${passay.version}</version>
            </dependency>
            <!-- Distributed lock for @Scheduled jobs across multiple service
                 replicas (auth-service). -->
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-jdbc-template</artifactId>
                <version>${shedlock.version}</version>
            </dependency>

            <!-- Errors / logging -->
            <dependency>
                <groupId>org.zalando</groupId>
                <artifactId>problem-spring-web-starter</artifactId>
                <version>${problem.spring.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash.encoder.version}</version>
            </dependency>
            <dependency>
                <groupId>org.zalando</groupId>
                <artifactId>logbook-spring-boot-starter</artifactId>
                <version>${logbook.version}</version>
            </dependency>

            <!-- Testing stack (JUnit, AssertJ, Mockito, Awaitility, Testcontainers
                 come from Boot). Testcontainers 2.x renamed its modules:
                 org.testcontainers:postgresql is now testcontainers-postgresql,
                 junit-jupiter is testcontainers-junit-jupiter, kafka is
                 testcontainers-kafka, and so on. -->
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured</artifactId>
                <version>${restassured.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
